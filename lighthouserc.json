{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.4 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "resource-summary:font:size": ["warn", { "maxNumericValue": 1200000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 4000000 }]
      }
    }
  }
}
